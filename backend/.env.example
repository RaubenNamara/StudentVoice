# Copy to backend/.env and fill in. backend/.env is never committed.

APP_ENV=local
# true shows real error messages in API replies - never true on the live server
APP_DEBUG=true
APP_TIMEZONE=Africa/Kampala

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
# On cPanel the name has the account's prefix, e.g. stmarks_studentvoice
DB_NAME=studentvoice

# Shown on the voting pages and slips
SCHOOL_NAME="St. Mark's College Namagoma"

# The school's SMIS student list (RegNo, Name, Class, Stream) - the same one Tusome syncs from
SMIS_STUDENTS_API_URL=https://smisug.com//STMARKLIBRARYAPI/SLISLIBRARYAPI/api/student

# Admins are signed out after this long without activity; students after STUDENT_IDLE_MINUTES
SESSION_IDLE_MINUTES=30
STUDENT_IDLE_MINUTES=15
